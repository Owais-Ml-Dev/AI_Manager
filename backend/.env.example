# Supabase Postgres connection (Settings > Database > Connection string, URI, "Transaction" pooler for asyncpg)
# Must use the asyncpg driver: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase project URL (not a secret) - used to verify Supabase Auth tokens via its JWKS endpoint
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co


# Upstash Redis (Upstash console > Redis DB > "Redis" connect tab, rediss:// = TLS)
REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# Google Gemini API key (added in a later phase, kept here so .env has one place for all secrets)
GEMINI_API_KEY=

ENVIRONMENT=development
